# Database Configuration
# In Docker, hostname is 'db'. Locally, use 'localhost'.
DB_HOST=localhost
DB_PORT=3306
MYSQL_PORT=3307

# Database Credentials
# These are used for both the database container and the application connection
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_USER=bookboss
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_DATABASE=bookboss

# Application Credentials for Connection
# Uses MYSQL_USER/PASSWORD/DATABASE above

# Server Configuration
PORT=5000
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_JWT_SECRET_RUN_COMMAND_ABOVE

# CORS: comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# Optional: Notifications (ntfy.sh)
# NTFY_TOPIC=bookboss_notifications
# NTFY_SERVER_URL=https://ntfy.sh
# Optional: Cloudflare Zero Trust Service Auth for NTFY
# NTFY_SA_ID="CF-Access-Client-Id: your-client-id.access"
# NTFY_SA_SECRET="CF-Access-Client-Secret: your-client-secret"

# Optional: GitHub Integration
GITHUB_REPO=daedaebae/BookBoss
# GITHUB_TOKEN=ghp_your_personal_access_token_here